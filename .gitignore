
# ==========================================
# ResolveAI - Git Ignore
# ==========================================

# Environment variables and secret credentials
.env
.env.*
!.env.example
server/.env
server/.env.*

# Node.js dependencies
node_modules/
server/node_modules/

# Private user and complaint data
server/users.json
server/complaint.json
server/complaints.json

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build and generated files
dist/
build/
coverage/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor settings
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.swp
*.bak
